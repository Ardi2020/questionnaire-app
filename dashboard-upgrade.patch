+  if (provinsi === "Sumatera Barat") return "Sumatera";
+  if (["DKI Jakarta", "Jawa Barat", "Jawa Tengah", "DI Yogyakarta", "Jawa Timur", "Banten"].includes(provinsi)) return "Jawa";
+  return "";
+}
+
+export function filterHospitals(
+  jenisRS?: string,
+  kelasRS?: string,
+  provinsi?: string
+): Hospital[] {
+  return HOSPITALS.filter((h) => {
+    if (jenisRS) {
+      const kep = jenisRS.includes("Publik") ? "Publik" : "Swasta";
+      if (h.kepemilikan !== kep) return false;
+    }
+    if (kelasRS) {
+      const k = kelasRS.replace("Kelas ", "");
+      if (h.kelas !== k) return false;
+    }
+    if (provinsi && h.provinsi !== provinsi) return false;
+    return true;
+  });
+}
